diff --git a/cjs/src/connection.js b/cjs/src/connection.js
index 07f6716702ac888215c86ad6e0071aaf55ae519c..130241da44a943677fd17c61f8cc40409ccf122e 100644
--- a/cjs/src/connection.js
+++ b/cjs/src/connection.js
@@ -157,6 +157,14 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
     if (terminated)
       return queryError(q, Errors.connection('CONNECTION_DESTROYED', options))
 
+    // A scope that outlived its closed connection (a transaction's ROLLBACK
+    // after the server dropped it) must not queue a write for a null socket,
+    // which throws outside any promise (porsager/postgres#1154). Reject it
+    // and answer true ("not full"), or the scope's handler moves the closed
+    // connection into the full queue, which nothing ever empties.
+    if (!socket)
+      return queryError(q, Errors.connection('CONNECTION_CLOSED', options)), true
+
     if (stream)
       return queryError(q, Errors.generic('COPY_IN_PROGRESS', 'You cannot execute queries during copy'))
 
@@ -419,7 +427,7 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
     )
   }
 
-  function terminate() {
+  function terminate(force = false) {
     terminated = true
     if (stream || query || initial || sent.length)
       error(Errors.connection('CONNECTION_DESTROYED', options))
@@ -428,7 +436,9 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
     if (socket) {
       socket.removeListener('data', data)
       socket.removeListener('connect', connected)
-      socket.readyState === 'open' && socket.end(b().X().end())
+      force
+        ? socket.destroy()
+        : socket.readyState === 'open' && socket.end(b().X().end())
     }
     ended && (ended(), ending = ended = null)
   }
@@ -438,6 +448,11 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
     remaining = 0
     incomings = null
     clearImmediate(nextWriteTimer)
+    // Forget the dead session's state, so the reconnected one starts clean:
+    // the cancelled write (else a reconnect never sends its startup message),
+    // and a FATAL error still waiting for a ReadyForQuery that will never
+    // come (else it fails the next session's first query).
+    nextWriteTimer = chunk = errorResponse = null
     socket.removeListener('data', data)
     socket.removeListener('connect', connected)
     idleTimer.cancel()
@@ -451,6 +466,9 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
       return reconnect()
 
     !hadError && (query || sent.length) && error(Errors.connection('CONNECTION_CLOSED', options, socket))
+    // The query in flight is rejected above; it must not be taken for the
+    // next session's.
+    query = null
     closedTime = performance.now()
     hadError && options.shared.retries++
     delay = (typeof backoff === 'function' ? backoff(options.shared.retries) : backoff) * 1000
@@ -559,15 +577,22 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
           return terminate()
       }
 
-      if (needsTypes) {
-        initial.reserve && (initial = null)
-        return fetchArrayTypes()
-      }
+      // The connection reads its array types before the query or reservation
+      // that opened it gets it. A reservation stays in `initial` meanwhile, so
+      // a connection closed during the read reconnects for it, as for a
+      // query, rather than dropping it. The read is caught: nothing else
+      // handles its promise, so its rejection ended the process.
+      if (needsTypes)
+        return fetchArrayTypes().catch(noop)
 
+      const reservation = initial.reserve
       initial && !initial.reserve && execute(initial)
       options.shared.retries = retries = 0
       initial = null
-      return
+      // A reservation is handed the connection by onopen() below, from the
+      // pool's queue, where reserve() left it.
+      if (!reservation)
+        return
     }
 
     while (sent.length && (query = sent.shift()) && (query.active = true, query.cancelled))
diff --git a/cjs/src/index.js b/cjs/src/index.js
index f09c61c7e998f411560b95c9a8e1ed6a97972c11..e5690a2178906c7e949a34d350885d3fe0f92e66 100644
--- a/cjs/src/index.js
+++ b/cjs/src/index.js
@@ -219,7 +219,10 @@ function Postgres(a, b) {
     const sql = Sql(handler)
     sql.release = () => {
       c.reserved = null
-      onopen(c)
+      // A reserved connection that closed meanwhile is already in the closed
+      // (or, reconnecting, the connecting) queue: returning it to the open
+      // queue would hand a dead connection to every later query.
+      ;(c.queue === reserved || c.queue === full) && onopen(c)
     }
 
     return sql
@@ -382,7 +385,7 @@ function Postgres(a, b) {
   }
 
   async function destroy(resolve) {
-    await Promise.all(connections.map(c => c.terminate()))
+    await Promise.all(connections.map(c => c.terminate(true)))
     while (queries.length)
       queries.shift().reject(Errors.connection('CONNECTION_DESTROYED', options))
     resolve()
