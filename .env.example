# ---------------------------------------------------------------------------
# Open Chat Interface — environment configuration
# Copy to .env and change every secret before exposing the instance.
# ---------------------------------------------------------------------------

NODE_ENV=development

# Public URL users reach. Must match the reverse proxy origin in production.
APP_URL=http://localhost:5173
# Comma-separated origins for explicitly trusted internal OIDC/SAML IdPs.
# AUTH_TRUSTED_ORIGINS=http://localhost:8090,https://idp.internal.example
API_PORT=3080

# Postgres. The dev compose file publishes on 5439 to avoid port collisions.
DATABASE_URL=postgres://oci:oci_dev_password@localhost:5439/oci

# Optional but recommended: enables resumable streams, rate limits, and jobs.
REDIS_URL=redis://localhost:6389
# Redis replay data expires after this bounded interval (60-3600 seconds).
CHAT_STREAM_TTL_SECONDS=900

# Session signing key. Minimum 32 characters.
#   openssl rand -base64 48
AUTH_SECRET=replace_me_with_a_long_random_value_00000

# Encrypts provider API keys and SMTP credentials at rest. Minimum 32
# characters. Rotating this invalidates every stored credential.
ENCRYPTION_KEY=replace_me_with_a_different_random_value

# First administrator, created on an empty database. If the password is
# omitted a one-time password is printed to the container logs.
INITIAL_ADMIN_EMAIL=admin@example.com
# Leave blank to generate a one-time password at first boot.
INITIAL_ADMIN_PASSWORD=

# Local attachment storage (used when the storage driver is "local").
STORAGE_LOCAL_PATH=./data/storage

LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Production compose only
# ---------------------------------------------------------------------------
# OCI_PORT=8080
# POSTGRES_PASSWORD=change_me
# Pin both to the same release when deploying from the GitLab registry.
# OCI_API_IMAGE=registry.gitlab.it.ufl.edu/ict/aipe/software/open-chat-interface/api:v0.1.0
# OCI_WEB_IMAGE=registry.gitlab.it.ufl.edu/ict/aipe/software/open-chat-interface/web:v0.1.0
