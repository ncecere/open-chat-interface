{
  "realm": "oci-test",
  "displayName": "OCI Authentication Test",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "users": [
    {
      "username": "oci-test-user",
      "email": "oci-test-user@example.com",
      "emailVerified": true,
      "enabled": true,
      "firstName": "OCI",
      "lastName": "Tester",
      "credentials": [
        {
          "type": "password",
          "value": "OciTestPass123!",
          "temporary": false
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "oci-oidc",
      "name": "OCI OIDC Test Client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "oci-oidc-test-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:5173/api/auth/sso/callback/oci-oidc"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": ["web-origins", "acr", "roles", "profile", "email"]
    }
  ]
}
