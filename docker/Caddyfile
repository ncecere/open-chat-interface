{
	admin off
	auto_https off

	# The client address. With TRUSTED_PROXIES unset nothing in front is
	# trusted and the client is whoever connected. Behind another proxy or a
	# Kubernetes ingress, set it to that proxy's addresses (space-separated IPs
	# or CIDR ranges, or private_ranges) and the client is read from the
	# X-Forwarded-For it sends, right to left, skipping trusted hops, so a
	# client cannot forge it by sending its own header.
	servers {
		trusted_proxies static {$TRUSTED_PROXIES:}
		client_ip_headers X-Forwarded-For
		trusted_proxies_strict
	}

	# While the API cannot be reached, the proxy looks its name up again on
	# every try within lb_try_duration and logs each failed lookup at error
	# level ("failed getting dynamic upstreams"): about 47 lines a request at
	# a 100 ms interval, over 1,000 for one 40-second API restart (#289). The
	# proxy's own messages go to a logger of their own that keeps the first
	# of each message every 10 s and one in 1,000 after it. Every failed
	# request still logs its own error (logger http.log.error), so an outage
	# shows as one line per request, plus the cause every 10 s.
	log default {
		exclude http.handlers.reverse_proxy
	}
	log proxy {
		include http.handlers.reverse_proxy
		sampling {
			interval 10s
			first 1
			thereafter 1000
		}
	}
}

# How the web container reaches the API, shared by its two proxies below.
(api_upstream) {
	# Compose assigns one DNS name to every API replica. Re-resolving it
	# lets Caddy discover replicas as they scale; without this it pins to
	# whichever address it saw first. Every 2 s, so a replica that has
	# exited (and left DNS) is forgotten quickly; Docker's resolver is local.
	dynamic a {
		name {$API_UPSTREAM_HOST:api}
		port {$API_UPSTREAM_PORT:3000}
		refresh 2s
	}

	# The API trusts exactly one client address: the one worked out above.
	# Replace whatever chain arrived, and drop the other client-address
	# headers a client could send straight through.
	header_up X-Forwarded-For {client_ip}
	header_up -X-Real-IP
	header_up -CF-Connecting-IP
	header_up -True-Client-IP
	header_up -Forwarded

	# Streaming responses must not be buffered.
	flush_interval -1

	# Sessions are cookie-signed and stream resume goes through Redis, so
	# no affinity is required; a failed replica is simply retried.
	lb_try_duration 5s
	# Each try also looks the API name up again, so with no replica up a
	# request made 50 lookups at 100 ms. 250 ms halves that, and adds at
	# most 150 ms before a failed connection is tried on another replica
	# or, for chat turns, a replica marked down is tried again (#289).
	lb_try_interval 250ms

	transport http {
		# Replicas are on the same network: a connection that takes more
		# than a second is going to a replica that has gone.
		dial_timeout 1s
		# Below the API's 65 s keep-alive, so Caddy never sends a request on
		# a connection the API is closing (a 502 for anything but GET).
		keepalive 30s
	}
}

:8080 {
	encode gzip zstd

	# API and auth traffic goes to the Hono service. Keeping this same-origin
	# means session cookies need no CORS or SameSite=None handling.
	handle /api/* {
		# New chat turns (a message, and continuing after tool approvals): the
		# requests a draining replica refuses (apps/api/src/lib/drain.ts).
		@chatTurn {
			method POST
			path_regexp ^/api/chat(/[^/]+/approvals)?/?$
		}

		# Caddy runs no active health checks for dynamic upstreams, so a
		# replica leaves rotation through passive checks on real requests. A
		# replica shutting down refuses new chat turns with 503 (see
		# docs/OPERATIONS.md, "Shutting down and draining"); one that has exited
		# refuses or times out connections. Either takes it out of rotation for
		# chat turns for 3 s, and every further refused turn or failed
		# connection takes it out again, so the client's resend of a refused turn
		# goes to another replica.
		#
		# Longer than the client's resends: a refused turn is sent again after
		# Retry-After (1 s), up to twice, about 2 s after the first. Each web
		# replica keeps its own mark, and a resend can arrive through another
		# web replica, so a 2 s mark could expire on the first one just before
		# the last resend reached it: all three tries landed on the draining
		# replica (seen in the rolling-upgrade test).
		#
		# Shorter than lb_try_duration, so that with a single replica (the
		# default Compose stack) a turn that arrives while it is marked waits
		# out the 3 s rather than failing with "no upstreams" (#117).
		reverse_proxy @chatTurn {$API_UPSTREAM:api:3000} {
			import api_upstream
			# A reply streams for a while, so the replica with the fewest in progress.
			lb_policy least_conn
			fail_duration 3s
			max_fails 1
			unhealthy_status 503
		}

		# Everything else. A draining replica answers all of it as usual (only
		# new turns are refused), so it is not taken out of rotation for these;
		# and it must not look at the chat turns' marks either. Caddy keeps
		# one failure count per replica address, shared by every proxy, and
		# applies each proxy's own max_fails to it: with the marks counting here
		# too, a single replica refusing the turns that several tabs sent and
		# resent was marked again each time a queued turn reached it, and a
		# request waiting meanwhile could wait the whole 5 s and fail with "no
		# upstreams available" (#306). So no passive checks here: a failed
		# connection is tried again on the next replica in turn (round robin)
		# within lb_try_duration, and a replica that has exited leaves at the
		# next lookup (2 s).
		reverse_proxy {$API_UPSTREAM:api:3000} {
			import api_upstream
			lb_policy round_robin
		}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# The artifact sandbox host (v0.9) is the one page OCI frames itself. It is
	# loaded with sandbox="allow-scripts" (an opaque origin) and gets its own
	# policy: a CSP sandbox, so it stays opaque even if framed or opened without
	# that attribute, inline code and data: images only, no network at all. The
	# page itself also refuses to write anything unless its origin is opaque.
	# Every other response keeps the application policy, which forbids framing.
	@artifactFrame path /artifact-frame.html
	@application not path /artifact-frame.html

	header @application {
		Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy same-origin
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	header @artifactFrame {
		Content-Security-Policy "sandbox allow-scripts; default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data: blob:; font-src data:; base-uri 'none'; form-action 'none'; frame-ancestors 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), display-capture=()"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Cache-Control "no-cache"
		-Server
	}

	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
}
