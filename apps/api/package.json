{
  "name": "@oci/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"**/*.live.test.ts\"",
    "test:unit": "vitest run src/__tests__/unit src/services/share-links.test.ts src/services/storage/config.test.ts",
    "test:integration": "vitest run src/__tests__/integration",
    "admin:promote": "tsx --env-file=../../.env src/scripts/promote-admin.ts",
    "test:live": "vitest run src/__tests__/live",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.33",
    "@ai-sdk/google": "4.0.36",
    "@ai-sdk/openai": "4.0.33",
    "@ai-sdk/openai-compatible": "3.0.25",
    "@aws-sdk/client-s3": "3.1105.0",
    "@better-auth/sso": "1.6.26",
    "@hono/node-server": "2.1.0",
    "@oci/db": "workspace:*",
    "@oci/shared": "workspace:*",
    "ai": "7.0.55",
    "better-auth": "1.6.26",
    "file-type": "22.0.1",
    "hono": "4.13.0",
    "ioredis": "6.0.0",
    "nanoid": "6.0.1",
    "nodemailer": "9.0.1",
    "pino": "10.3.1",
    "unpdf": "1.8.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@oci/config": "workspace:*",
    "@types/node": "22.20.0",
    "@types/nodemailer": "7.0.11",
    "@vitest/coverage-v8": "3.2.6",
    "pino-pretty": "13.1.3",
    "postgres": "3.4.9",
    "tsx": "4.23.9",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  }
}
