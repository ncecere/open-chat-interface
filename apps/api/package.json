{
  "name": "@oci/api",
  "version": "0.11.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"**/*.live.test.ts\"",
    "test:unit": "vitest run src/__tests__/unit src/services/share-links.test.ts src/services/storage/config.test.ts",
    "test:integration": "vitest run src/__tests__/integration",
    "admin:promote": "tsx --env-file=../../.env src/scripts/promote-admin.ts",
    "backup:restore-files": "tsx src/scripts/restore-backup-files.ts",
    "upgrade:check": "tsx --env-file-if-exists=../../.env src/scripts/upgrade-check.ts",
    "test:live": "vitest run src/__tests__/live",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.33",
    "@ai-sdk/google": "4.0.36",
    "@ai-sdk/mcp": "2.0.27",
    "@ai-sdk/openai": "4.0.33",
    "@ai-sdk/openai-compatible": "3.0.25",
    "@aws-sdk/client-s3": "3.1105.0",
    "@better-auth/sso": "1.6.26",
    "@hono/node-server": "2.1.0",
    "@oci/db": "workspace:*",
    "@oci/shared": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@streamparser/json": "0.0.26",
    "ai": "7.0.55",
    "better-auth": "1.6.26",
    "bidi-js": "1.1.0",
    "busboy": "1.6.0",
    "docx": "9.7.2",
    "fflate": "0.8.3",
    "file-type": "22.0.1",
    "hono": "4.13.7",
    "ioredis": "6.0.0",
    "markdown-it": "15.0.2",
    "nodemailer": "10.0.9",
    "pdfkit": "0.20.2",
    "pino": "10.3.1",
    "pptxgenjs": "4.0.1",
    "unpdf": "1.8.0",
    "zod": "4.4.3"
  },
  "optionalDependencies": {
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-arabic": "5.3.0",
    "@fontsource/noto-sans-hebrew": "5.3.0",
    "@fontsource/noto-sans-jp": "5.3.0",
    "@fontsource/noto-sans-kr": "5.3.0",
    "@fontsource/noto-sans-sc": "5.3.0"
  },
  "devDependencies": {
    "@oci/config": "workspace:*",
    "@types/busboy": "1.5.4",
    "@types/node": "22.20.0",
    "@types/pdfkit": "0.17.6",
    "@vitest/coverage-v8": "4.1.11",
    "exceljs": "4.4.0",
    "pino-pretty": "13.1.3",
    "postgres": "3.4.9",
    "tsx": "4.23.9",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
