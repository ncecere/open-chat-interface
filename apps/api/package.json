    "test": "vitest run",
    "admin:promote": "tsx --env-file=../../.env src/scripts/promote-admin.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.33",
    "@ai-sdk/google": "4.0.36",
    "@ai-sdk/openai": "4.0.33",
    "@ai-sdk/openai-compatible": "3.0.25",
    "@better-auth/sso": "1.6.26",
    "@hono/node-server": "2.1.0",
    "@oci/db": "workspace:*",
    "@oci/shared": "workspace:*",
    "ai": "7.0.55",
    "better-auth": "1.6.26",
    "hono": "4.13.0",
    "ioredis": "6.0.0",
    "nanoid": "6.0.1",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@oci/config": "workspace:*",
    "@types/node": "22.20.0",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.9",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
