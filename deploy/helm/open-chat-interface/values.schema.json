{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Open Chat Interface Helm chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "clusterDomain": {
      "type": "string",
      "minLength": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            }
          },
          "required": ["repository"]
        },
        "web": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            }
          },
          "required": ["repository"]
        },
        "pullPolicy": {
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "pullSecrets": {
          "type": "array"
        }
      },
      "required": ["api", "web"]
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "values": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          },
          "description": "Evaluation only: Secret data rendered by the chart."
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "appUrl": {
          "type": "string",
          "description": "Public URL people use (required).",
          "pattern": "^(https?://.+)?$"
        },
        "authTrustedOrigins": {
          "type": "string"
        },
        "logLevel": {
          "enum": ["fatal", "error", "warn", "info", "debug", "trace"]
        },
        "storageLocalPath": {
          "type": "string",
          "minLength": 1,
          "pattern": "^/"
        },
        "shutdownDrainTimeoutMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "migrationLockTimeoutMs": {
          "type": ["integer", "string"],
          "pattern": "^[0-9]*$"
        },
        "migrationStatementTimeoutMs": {
          "type": ["integer", "string"],
          "pattern": "^[0-9]*$"
        },
        "postMigrationStatementTimeoutMs": {
          "type": ["integer", "string"],
          "pattern": "^[0-9]*$"
        },
        "otelExporterOtlpEndpoint": {
          "type": "string",
          "pattern": "^(https?://\\S+)?$"
        },
        "otelServiceName": {
          "type": "string"
        },
        "env": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        }
      }
    },
    "redis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sentinels": {
          "type": "string"
        },
        "clusterNodes": {
          "type": "string"
        }
      }
    },
    "extraEnv": {
      "type": "array"
    },
    "extraEnvFrom": {
      "type": "array"
    },
    "migrations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hookDeletePolicy": {
          "type": "string",
          "pattern": "^(before-hook-creation|hook-succeeded|hook-failed)(,(before-hook-creation|hook-succeeded|hook-failed))*$"
        },
        "ttlSecondsAfterFinished": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "pre": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "activeDeadlineSeconds": {
              "type": "integer",
              "minimum": 60
            },
            "backoffLimit": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "post": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "activeDeadlineSeconds": {
              "type": "integer",
              "minimum": 60
            },
            "backoffLimit": {
              "type": "integer",
              "minimum": 0
            },
            "waitForRollout": {
              "type": "boolean"
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            },
            "claims": {
              "type": "array"
            }
          }
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "strategy": {
          "type": "object",
          "properties": {
            "type": {
              "enum": ["RollingUpdate", "Recreate"]
            },
            "rollingUpdate": {
              "type": "object",
              "properties": {
                "maxSurge": {
                  "type": ["integer", "string"]
                },
                "maxUnavailable": {
                  "description": "Must be 0 (draining needs a ready replacement first).",
                  "enum": [0, "0", "0%"]
                }
              }
            }
          }
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            },
            "claims": {
              "type": "array"
            }
          }
        },
        "startupProbe": {
          "type": "object",
          "description": "A Kubernetes probe."
        },
        "readinessProbe": {
          "type": "object",
          "description": "A Kubernetes probe."
        },
        "livenessProbe": {
          "type": "object",
          "description": "A Kubernetes probe."
        },
        "podDisruptionBudget": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxUnavailable": {
              "type": ["integer", "string"]
            },
            "minAvailable": {
              "type": ["integer", "string"]
            }
          },
          "required": ["enabled"]
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "defaultTopologySpread": {
          "type": "boolean"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "priorityClassName": {
          "type": "string"
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "preStopSleepSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "preStopSleepAction": {
          "type": "boolean"
        },
        "autoscaling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "targetCPUUtilizationPercentage": {
              "type": ["integer", "string", "null"]
            },
            "targetMemoryUtilizationPercentage": {
              "type": ["integer", "string", "null"]
            },
            "metrics": {
              "type": "array",
              "description": "Extra HPA v2 metric specs (Pods, Object, External)."
            },
            "behavior": {
              "type": "object"
            }
          }
        },
        "extraVolumes": {
          "type": "array"
        },
        "extraVolumeMounts": {
          "type": "array"
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "annotations": {
              "type": "object"
            }
          }
        }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "strategy": {
          "type": "object",
          "properties": {
            "type": {
              "enum": ["RollingUpdate", "Recreate"]
            },
            "rollingUpdate": {
              "type": "object",
              "properties": {
                "maxSurge": {
                  "type": ["integer", "string"]
                },
                "maxUnavailable": {
                  "description": "Must be 0 (draining needs a ready replacement first).",
                  "enum": [0, "0", "0%"]
                }
              }
            }
          }
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            },
            "claims": {
              "type": "array"
            }
          }
        },
        "startupProbe": {
          "type": "object",
          "description": "A Kubernetes probe."
        },
        "readinessProbe": {
          "type": "object",
          "description": "A Kubernetes probe."
        },
        "livenessProbe": {
          "type": "object",
          "description": "A Kubernetes probe."
        },
        "podDisruptionBudget": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxUnavailable": {
              "type": ["integer", "string"]
            },
            "minAvailable": {
              "type": ["integer", "string"]
            }
          },
          "required": ["enabled"]
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "defaultTopologySpread": {
          "type": "boolean"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "priorityClassName": {
          "type": "string"
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "enabled": {
          "type": "boolean"
        },
        "extraVolumes": {
          "type": "array"
        },
        "extraVolumeMounts": {
          "type": "array"
        }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "strategy": {
          "type": "object",
          "properties": {
            "type": {
              "enum": ["RollingUpdate", "Recreate"]
            },
            "rollingUpdate": {
              "type": "object",
              "properties": {
                "maxSurge": {
                  "type": ["integer", "string"]
                },
                "maxUnavailable": {
                  "description": "Must be 0 (draining needs a ready replacement first).",
                  "enum": [0, "0", "0%"]
                }
              }
            }
          }
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            },
            "claims": {
              "type": "array"
            }
          }
        },
        "startupProbe": {
          "type": "object",
          "description": "A Kubernetes probe."
        },
        "readinessProbe": {
          "type": "object",
          "description": "A Kubernetes probe."
        },
        "livenessProbe": {
          "type": "object",
          "description": "A Kubernetes probe."
        },
        "podDisruptionBudget": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "maxUnavailable": {
              "type": ["integer", "string"]
            },
            "minAvailable": {
              "type": ["integer", "string"]
            }
          },
          "required": ["enabled"]
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "defaultTopologySpread": {
          "type": "boolean"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "priorityClassName": {
          "type": "string"
        },
        "podAnnotations": {
          "type": "object"
        },
        "podLabels": {
          "type": "object"
        },
        "preStopSleepSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "preStopSleepAction": {
          "type": "boolean"
        },
        "autoscaling": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "targetCPUUtilizationPercentage": {
              "type": ["integer", "string", "null"]
            },
            "targetMemoryUtilizationPercentage": {
              "type": ["integer", "string", "null"]
            },
            "metrics": {
              "type": "array",
              "description": "Extra HPA v2 metric specs (Pods, Object, External)."
            },
            "behavior": {
              "type": "object"
            }
          }
        },
        "trustedProxies": {
          "type": "string",
          "description": "Space-separated IPs/CIDRs (or private_ranges) of proxies in front of the web pods. Not commas.",
          "pattern": "^[^,]*$"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean"]
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "annotations": {
              "type": "object"
            }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api": {
          "type": "object"
        },
        "web": {
          "type": "object"
        }
      }
    },
    "containerSecurityContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "api": {
          "type": "object"
        },
        "web": {
          "type": "object"
        }
      }
    },
    "tmpVolume": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sizeLimit": {
          "type": "string"
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "existingClaim": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            },
            "accessModes": {
              "type": "array",
              "items": {
                "enum": ["ReadWriteOnce", "ReadWriteMany", "ReadWriteOncePod", "ReadOnlyMany"]
              }
            },
            "size": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            }
          }
        },
        "emptyDirSizeLimit": {
          "type": "string"
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["host"],
            "properties": {
              "host": {
                "type": "string"
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "pathType": {
                      "enum": ["Prefix", "Exact", "ImplementationSpecific"]
                    }
                  }
                }
              }
            }
          }
        },
        "tls": {
          "type": "array"
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "parentRefs": {
          "type": "array"
        },
        "hostnames": {
          "type": "array"
        },
        "ruleExtras": {
          "type": "object"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "webFrom": {
          "type": "array"
        },
        "metricsFrom": {
          "type": "array"
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "extraEgress": {
              "type": "array"
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "tokenSecretKey": {
              "type": "string",
              "minLength": 1
            },
            "interval": {
              "type": "string"
            },
            "scrapeTimeout": {
              "type": "string"
            },
            "labels": {
              "type": "object"
            }
          }
        },
        "prometheusRule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "labels": {
              "type": "object"
            }
          }
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "httpRoute": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "httpRoute": {
            "properties": {
              "parentRefs": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
